# Скопируйте в .env и заполните. Файл .env в репозиторий не класть.
# На VPS это делает deploy/vps-install.sh: домен передаётся аргументом.

# prod — обычный запуск. dev — только вместе с DEV_SKIP_AUTH=1 для локального экрана.
APP_ENV=prod
DEV_SKIP_AUTH=

# Домен мини-приложения. Если WEBAPP_URL пуст, сервис берёт https://DOMAIN.
DOMAIN=
ACME_EMAIL=

# Токен от BotFather. Пустой: HTTP живёт, бот не стартует (так устроены тесты).
TELEGRAM_BOT_TOKEN=

# Telegram user id Максима и Жени через запятую.
TELEGRAM_ALLOWED_USER_IDS=

# HTTPS-адрес мини-приложения. Пустой: https://DOMAIN.
WEBAPP_URL=

# fixture — числа прототипа, без таблицы. sheets — живая книга, только чтение.
# Для первой проверки на VPS оставьте fixture.
DATA_SOURCE=fixture
BUDGET_SPREADSHEET_ID=1n_Yp3gHkX-jNZGD5Mn4IYxPtAixZhF6xyXNVurUZrBI

# Локально: JSON ключа целиком или путь к файлу.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# На VPS: путь к JSON на хосте, вне репозитория. Скрипт монтирует его в контейнер.
GOOGLE_SA_FILE=

# Куда публиковать порт приложения. Локально 8080.
# Скрипт VPS ставит 127.0.0.1:8080, снаружи только 80 и 443.
HTTP_PUBLISH=8080

CACHE_TTL=3m
ADDR=:8080
BUDGET_CONFIG=config/budget.yaml
SHEETS_CONFIG=config/sheets.yaml
FIXTURE_CONFIG=config/fixture.yaml
STATIC_DIR=web/dist
